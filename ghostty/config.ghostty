# Configure the terminal appearance and keyboard shortcuts.
copy-on-select = clipboard

# Install terminal definitions over SSH, with a fallback for unsupported hosts.
shell-integration-features = ssh-env,ssh-terminfo

font-family = Hack Nerd Font
font-size = 12
adjust-cell-height = 1

theme = TokyoNight
background-opacity = 0.95
background-blur = 40
macos-titlebar-style = hidden
# Use Aura's purple cursor.
cursor-color = #a277ff
# Make bar and outlined cursors one pixel thicker.
adjust-cursor-thickness = 1

# Open a new terminal window instead of a tab.
keybind = cmd+t=new_window

# Send Herdr's Ctrl+A prefix from Cmd+A.
# This replaces Ghostty's Cmd+A Select All shortcut. Ctrl+A also works normally.
keybind = cmd+a=text:\x01

# Send Escape followed by Line Feed for multiline command input.
keybind = ctrl+enter=text:\x1b\x0a

# Send Ctrl+Arrow sequences for word navigation.
keybind = ctrl+left=text:\x1b[1;5D
keybind = ctrl+right=text:\x1b[1;5C

# Use left Option for Herdr's Alt-based pane swaps. Keep right Option for symbols.
macos-option-as-alt = left
