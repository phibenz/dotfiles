# general
prefix_rule(pattern=["curl"], decision="allow")
prefix_rule(pattern=["printf", "%s"], decision="allow")
prefix_rule(pattern=["pbcopy"], decision="allow")
prefix_rule(pattern=["sort"], decision="allow")
# bq
prefix_rule(pattern=["bq"], decision="allow")
prefix_rule(pattern=["bq", "query"], decision="allow")
prefix_rule(pattern=["bq", "show"], decision="allow")
# docker
prefix_rule(pattern=["docker", "build"], decision="allow")
prefix_rule(pattern=["docker", "buildx", "build"], decision="allow")
prefix_rule(pattern=["docker", "compose", "build"], decision="allow")
prefix_rule(pattern=["docker", "compose", "config"], decision="allow")
prefix_rule(pattern=["docker", "compose", "exec"], decision="allow")
prefix_rule(pattern=["docker", "compose", "logs"], decision="allow")
prefix_rule(pattern=["docker", "compose", "ps"], decision="allow")
prefix_rule(pattern=["docker", "compose", "pull"], decision="allow")
prefix_rule(pattern=["docker", "compose", "up"], decision="allow")
prefix_rule(pattern=["docker", "container", "ls"], decision="allow")
prefix_rule(pattern=["docker", "exec"], decision="allow")
prefix_rule(pattern=["docker", "image", "ls"], decision="allow")
prefix_rule(pattern=["docker", "images"], decision="allow")
prefix_rule(pattern=["docker", "info"], decision="allow")
prefix_rule(pattern=["docker", "inspect"], decision="allow")
prefix_rule(pattern=["docker", "logs"], decision="allow")
prefix_rule(pattern=["docker", "manifest", "inspect"], decision="allow")
prefix_rule(pattern=["docker", "network", "ls"], decision="allow")
prefix_rule(pattern=["docker", "ps"], decision="allow")
prefix_rule(pattern=["docker", "pull"], decision="allow")
prefix_rule(pattern=["docker", "restart"], decision="allow")
prefix_rule(pattern=["docker", "start"], decision="allow")
prefix_rule(pattern=["docker", "stats"], decision="allow")
prefix_rule(pattern=["docker", "stop"], decision="allow")
prefix_rule(pattern=["docker", "system", "df"], decision="allow")
prefix_rule(pattern=["docker", "tag"], decision="allow")
prefix_rule(pattern=["docker", "top"], decision="allow")
prefix_rule(pattern=["docker", "version"], decision="allow")
prefix_rule(pattern=["docker", "volume", "ls"], decision="allow")
# gcx
prefix_rule(pattern=["gcx"], decision="allow")
prefix_rule(pattern=["gcx", "config", "check"], decision="allow")
prefix_rule(pattern=["gcx", "metrics", "query"], decision="allow")
# linearis
prefix_rule(pattern=["linearis"], decision="allow")
prefix_rule(pattern=["linear"], decision="allow")
# git
prefix_rule(pattern=["git", "add"], decision="allow")
prefix_rule(pattern=["git", "commit"], decision="allow")
prefix_rule(pattern=["git", "fetch"], decision="allow")
prefix_rule(pattern=["git", "pull"], decision="allow")
prefix_rule(pattern=["git", "push"], decision="allow")
prefix_rule(pattern=["git", "stash"], decision="allow")
# gh
prefix_rule(pattern=["gh", "pr", "list"], decision="allow")
prefix_rule(pattern=["gh", "pr", "view"], decision="allow")
prefix_rule(pattern=["gh", "pr", "create"], decision="allow")
prefix_rule(pattern=["gh", "pr", "edit"], decision="allow")
# pre-commit
prefix_rule(pattern=["pre-commit", "run"], decision="allow")
# uv
prefix_rule(pattern=["uv", "run"], decision="allow")
prefix_rule(pattern=["uv", "run", "ty"], decision="allow")
prefix_rule(pattern=["uv", "run", "pytest"], decision="allow")
# rust
prefix_rule(pattern=["cargo", "build"], decision="allow")
