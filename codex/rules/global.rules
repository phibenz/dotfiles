# general
prefix_rule(pattern=["printf", "%s"], decision="allow")
prefix_rule(pattern=["pbcopy"], decision="allow")
# bq
prefix_rule(pattern=["bq"], decision="allow")
prefix_rule(pattern=["bq", "query"], decision="allow")
prefix_rule(pattern=["bq", "show"], decision="allow")
# gcx
prefix_rule(pattern=["gcx"], decision="allow")
prefix_rule(pattern=["gcx", "config", "check"], decision="allow")
prefix_rule(pattern=["gcx", "metrics", "query"], decision="allow")
# linearis
prefix_rule(pattern=["linearis"], decision="allow")
prefix_rule(pattern=["linear"], decision="allow")
# git
prefix_rule(pattern=["git", "add"], decision="allow")
prefix_rule(pattern=["git", "commit"], decision="allow")
prefix_rule(pattern=["git", "fetch"], decision="allow")
prefix_rule(pattern=["git", "pull"], decision="allow")
prefix_rule(pattern=["git", "push"], decision="allow")
prefix_rule(pattern=["git", "stash"], decision="allow")
# gh
prefix_rule(pattern=["gh", "pr", "list"], decision="allow")
prefix_rule(pattern=["gh", "pr", "view"], decision="allow")
prefix_rule(pattern=["gh", "pr", "create"], decision="allow")
prefix_rule(pattern=["gh", "pr", "edit"], decision="allow")
# pre-commit
prefix_rule(pattern=["pre-commit", "run"], decision="allow")
# uv
prefix_rule(pattern=["uv", "run"], decision="allow")
prefix_rule(pattern=["uv", "run", "ty"], decision="allow")
prefix_rule(pattern=["uv", "run", "pytest"], decision="allow")
# rust
prefix_rule(pattern=["cargo", "build"], decision="allow")
prefix_rule(pattern=["cargo", "check"], decision="allow")
prefix_rule(pattern=["cargo", "clippy"], decision="allow")
prefix_rule(pattern=["cargo", "fmt"], decision="allow")
prefix_rule(pattern=["cargo", "metadata"], decision="allow")
prefix_rule(pattern=["cargo", "test"], decision="allow")
# gcloud
prefix_rule(pattern=["gcloud", "storage", "cat"], decision="allow")
